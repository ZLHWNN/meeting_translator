{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting-translator.local/protocol/v1/websocket-protocol.schema.json",
  "title": "Meeting Translator WebSocket Protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/sessionControl" },
    { "$ref": "#/$defs/utteranceStart" },
    { "$ref": "#/$defs/utteranceCommit" },
    { "$ref": "#/$defs/directionSet" },
    { "$ref": "#/$defs/translationRetry" },
    { "$ref": "#/$defs/sessionReady" },
    { "$ref": "#/$defs/commandAck" },
    { "$ref": "#/$defs/sessionState" },
    { "$ref": "#/$defs/transcriptInterim" },
    { "$ref": "#/$defs/transcriptFinal" },
    { "$ref": "#/$defs/translationPending" },
    { "$ref": "#/$defs/translationCompleted" },
    { "$ref": "#/$defs/translationFailed" },
    { "$ref": "#/$defs/backpressure" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/sessionCompleted" }
  ],
  "$defs": {
    "commandId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "utteranceId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "direction": { "type": "string", "enum": ["en-to-zh", "zh-to-en"] },
    "language": { "type": "string", "enum": ["en", "zh"] },
    "base": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" } } },
    "hello": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "hello" }, "protocolVersion": { "const": "1" }, "commandId": { "$ref": "#/$defs/commandId" }, "capabilities": { "type": "array", "items": { "type": "string" } } }, "required": ["type", "protocolVersion", "commandId"] }] },
    "sessionControl": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "session.control" }, "commandId": { "$ref": "#/$defs/commandId" }, "action": { "type": "string", "enum": ["start", "pause", "resume", "stop"] } }, "required": ["type", "commandId", "action"] }] },
    "utteranceStart": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "utterance.start" }, "commandId": { "$ref": "#/$defs/commandId" }, "utteranceId": { "$ref": "#/$defs/utteranceId" }, "direction": { "$ref": "#/$defs/direction" } }, "required": ["type", "commandId", "utteranceId", "direction"] }] },
    "utteranceCommit": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "utterance.commit" }, "commandId": { "$ref": "#/$defs/commandId" }, "utteranceId": { "$ref": "#/$defs/utteranceId" } }, "required": ["type", "commandId", "utteranceId"] }] },
    "directionSet": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "direction.set" }, "commandId": { "$ref": "#/$defs/commandId" }, "direction": { "$ref": "#/$defs/direction" } }, "required": ["type", "commandId", "direction"] }] },
    "translationRetry": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "translation.retry" }, "commandId": { "$ref": "#/$defs/commandId" }, "entryId": { "type": "string" }, "sourceText": { "type": "string", "minLength": 1 }, "sourceLanguage": { "$ref": "#/$defs/language" }, "targetLanguage": { "$ref": "#/$defs/language" }, "context": { "type": "array", "maxItems": 3, "items": { "type": "string" } } }, "required": ["type", "commandId", "entryId", "sourceText", "sourceLanguage", "targetLanguage", "context"] }] },
    "sessionReady": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "session.ready" }, "sessionId": { "type": "string" }, "protocolVersion": { "const": "1" }, "expiresAt": { "type": "string", "format": "date-time" } }, "required": ["type", "sessionId", "protocolVersion", "expiresAt"] }] },
    "commandAck": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "command.ack" }, "commandId": { "$ref": "#/$defs/commandId" }, "accepted": { "type": "boolean" }, "state": { "type": "string", "enum": ["awaiting-hello", "ready", "configuring", "connecting", "running", "paused", "stopping", "completed"] }, "effectiveDirection": { "$ref": "#/$defs/direction" }, "errorCode": { "type": ["string", "null"] } }, "required": ["type", "commandId", "accepted", "state"] }] },
    "sessionState": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "session.state" }, "state": { "type": "string", "enum": ["configuring", "connecting", "running", "paused", "stopping", "completed"] } }, "required": ["type", "state"] }] },
    "transcriptInterim": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "transcript.interim" }, "utteranceId": { "$ref": "#/$defs/utteranceId" }, "providerItemId": { "type": "string" }, "revision": { "type": "integer", "minimum": 0 }, "text": { "type": "string" } }, "required": ["type", "utteranceId", "providerItemId", "revision", "text"] }] },
    "transcriptFinal": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "transcript.final" }, "utteranceId": { "$ref": "#/$defs/utteranceId" }, "providerItemId": { "type": "string" }, "elapsedMs": { "type": "integer", "minimum": 0 }, "committedAtMs": { "type": "integer", "minimum": 0 }, "sourceLanguage": { "$ref": "#/$defs/language" }, "targetLanguage": { "$ref": "#/$defs/language" }, "text": { "type": "string", "minLength": 1 } }, "required": ["type", "utteranceId", "providerItemId", "elapsedMs", "committedAtMs", "sourceLanguage", "targetLanguage", "text"] }] },
    "translationPending": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "translation.pending" }, "entryId": { "type": "string" }, "targetLanguage": { "$ref": "#/$defs/language" } }, "required": ["type", "entryId", "targetLanguage"] }] },
    "translationCompleted": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "translation.completed" }, "entryId": { "type": "string" }, "targetLanguage": { "$ref": "#/$defs/language" }, "text": { "type": "string", "minLength": 1 } }, "required": ["type", "entryId", "targetLanguage", "text"] }] },
    "translationFailed": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "translation.failed" }, "entryId": { "type": "string" }, "retryable": { "type": "boolean" }, "code": { "type": "string" }, "message": { "type": "string" } }, "required": ["type", "entryId", "retryable", "code", "message"] }] },
    "backpressure": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "backpressure" }, "bufferedAmountBytes": { "type": "integer", "minimum": 0 }, "action": { "enum": ["pause-capture", "resume-capture"] } }, "required": ["type", "bufferedAmountBytes", "action"] }] },
    "error": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "error" }, "retryable": { "type": "boolean" }, "code": { "type": "string" }, "message": { "type": "string" } }, "required": ["type", "retryable", "code", "message"] }] },
    "sessionCompleted": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "session.completed" }, "reason": { "type": "string", "enum": ["stopped", "expired", "disconnected", "error"] } }, "required": ["type", "reason"] }] }
  }
}
